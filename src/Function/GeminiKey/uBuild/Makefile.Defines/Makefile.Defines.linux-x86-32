#-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-

CC      = gcc
CPP     = g++
CXX     = g++
LD      = ld
AR      = ar
RANLIB  = ranlib

AR_FLAG = cru

CFLAGS +=	-Wall -g $(INCLUDE) -MD #-D_VERSION='"$(VERSION)"'

# turn off optimization if compiling with gcc 2.9.x:
#CFLAGS +=	-O0
#-m32
CFLAGS +=	-O2 -m32
CFLAGS +=       -fno-strict-aliasing


# uncomment depending on your operating system
CFLAGS +=	-DLINUX
#C():b(1),a(2){} //warning, should be C():a(2),b(1)
#CFLAGS +=       -Wno-reorder
