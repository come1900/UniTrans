CXX =		g++

CFLAGS +=	-Wall -g $(INCLUDE) -MD #-D_VERSION='"$(VERSION)"'

# turn off optimization if compiling with gcc 2.9.x:
#CFLAGS +=	-O0
CFLAGS +=	-O2


# uncomment depending on your operating system
CFLAGS +=	-DMACOSX 
CFLAGS +=	-D__DARWIN_UNIX03

LIBS +=		\
		-lssl -lcrypto \
		-lpthread

OBJS +=		Semaphore.o

