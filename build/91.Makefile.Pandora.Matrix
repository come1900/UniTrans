OBJS_GENERALAGENT += \
		$(BASEDIR_SRC)/Function/Stack/UniTransRestStack.o \
		$(BASEDIR_SRC)/Function/Stack/pq/PqStack.o

CFLAGS += -D_USE_DB_FILE
CFLAGS += -I$(EZLIBS_BASEDIR_LIBS)/include/sqlite++
LIBS   += -L$(EZLIBS_BASEDIR_LIBS)/lib -lsqlite++-$(PLATFORM)
