PROJECT_NAME=pandoraMatrix-uniTrans

DEF_VERSION =	1.5.1
DIFF_VERSION =	1.5.0
DEF_CONFIG_FILENAME_MAIN = cfg-$(PROJECT_NAME).cfg
DEF_CONFIG_FILENAME_MAIN_DUPLICATE = cfg-$(PROJECT_NAME).cfg.duplicate
DEF_LOG_FILENAME = log-$(PROJECT_NAME).log

#include         Makefile.Defines.$(PLATFORM)
include         Makefile.Defines/Makefile.Defines.$(PLATFORM)

#CFLAGS =	-Wall -g -O2 -MD
#CFLAGS += -D_DEBUG #debugme

CFLAGS += -D_CONFIG_FILENAME_MAIN='"$(DEF_CONFIG_FILENAME_MAIN)"'
CFLAGS += -D_CONFIG_FILENAME_MAIN_DUPLICATE='"$(DEF_CONFIG_FILENAME_MAIN_DUPLICATE)"'
CFLAGS += -D_VERSION='"$(DEF_VERSION)"'
CFLAGS += -D_LOG_FILENAME='"$(DEF_LOG_FILENAME)"'
CFLAGS += -D_PROJECT_NAME='"$(PROJECT_NAME)"'

##############################################################################
# 代码文件位置
BASEDIR_SRC=../src

##############################################################################
#库文件位置
#使用自带库, 目前自带 android 和 x86-32的库
#EZLIBS_BASEDIR_LIBS=../libs

##使用发布库
EZLIBS_BASEDIR_LIBS=$(HOME)/libs

BASEDIR_SRC_GENERALAGENT=$(BASEDIR_SRC)/Maintain

OBJS_GENERALAGENT = \
		$(BASEDIR_SRC_GENERALAGENT)/GeneralAgentLog.o \
		$(BASEDIR_SRC_GENERALAGENT)/GeneralAgentHandler.o\
		$(BASEDIR_SRC_GENERALAGENT)/GeneralAgentTcpSocket.o \
		$(BASEDIR_SRC_GENERALAGENT)/GeneralAgent.o

##############################################################################
# 配置模块
# Use ezConfig
CFLAGS += -D_USE_MODULES_EZCONFIG
CFLAGS += -I$(EZLIBS_BASEDIR_LIBS)/include/ezConfig
LIBS +=	-L$(EZLIBS_BASEDIR_LIBS)/lib -lezConfig-$(PLATFORM)
#json#thread
OBJS_CONFIGS	= \
		$(BASEDIR_SRC)/Configs/ConfigManager.o \
		$(BASEDIR_SRC)/Configs/ConfigGeneral.o \
		$(BASEDIR_SRC)/Configs/ConfigConsoleOverTcp.o \
		$(BASEDIR_SRC)/Configs/ConfigPandoraMatrix.o

###############################################################################
### 日志模块
ifeq ($(PLATFORM),linux-mips-openwrt)
	CFLAGS += -D_USE_EZLOG_CLASSIC
else ifeq ($(PLATFORM),linux-hi3515)
	CFLAGS += -D_USE_EZLOG_CLASSIC
else
	#CFLAGS += -D_USE_LOG4CPP
	#CFLAGS+=-I$(EZLIBS_BASEDIR_LIBS)/log4cplus-$(PLATFORM)/include
	#LIBS +=	-L$(EZLIBS_BASEDIR_LIBS)/log4cplus-$(PLATFORM)/lib -llog4cplus -lrt

	#同log4cpp互斥
	#CFLAGS += -D_USE_EZLOG_CLASSIC
	CFLAGS += -D_USE_EZLOG_FILENAME
endif

##############################################################################
## 串行调试模块
CFLAGS += -DFUNC_LOCAL_CONSOLE #串口调试接口
OBJS_GENERALAGENT += \
		$(BASEDIR_SRC)/Console/LocalConsole.o

##############################################################################
#改为基本组件
CFLAGS += -I$(HOME)/libs/include/gmini
LIBS   += -L$(HOME)/libs/lib -lgmini-$(PLATFORM)

# 授权管理模块
ifeq ($(PLATFORM),linux)
	CFLAGS += -D_FUNC_gMiniLicense #gmini license

	OBJS_GENERALAGENT += \
			$(BASEDIR_SRC)/Maintain/gMiniLicense.o
else ifeq ($(PLATFORM),linux-mips-mipsl-openwrt)
	#CFLAGS += -D_FUNC_gMiniLicense
else
	#CFLAGS += -D_FUNC_gMiniLicense
endif

