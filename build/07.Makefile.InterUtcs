#		$(BASEDIR_SRC_GENERALAGENT)/SocketMsgQue.o
#
#CFLAGS += -DEXAMPLE_GENERALAGENTHTTPSERVER #HTTP服务端
#OBJS_GENERALAGENT += \
#		$(BASEDIR_SRC_GENERALAGENT)/GeneralAgentHttpServer.o
#
#CFLAGS += -DEXAMPLE_SIGNAL_ONDATA #使用数据回调机制

#######################################################################################################
##WebService服务器
#CFLAGS += -DEXAMPLE_THE_WEBSERVICE
#OBJS_GENERALAGENT += \
#		$(BASEDIR_SRC)/WebService/Session.o \
#		$(BASEDIR_SRC)/WebService/WebServiceStack.o \
#		$(BASEDIR_SRC)/WebService/HandlerWebService.o \
#		$(BASEDIR_SRC)/WebService/HttpServerWebService.o \
