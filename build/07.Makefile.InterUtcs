#######################################################################################################
##PubService服务器
#CFLAGS += -DUSE_PUBSERVICE
#
#OBJS_GENERALAGENT += \
#		$(BASEDIR_SRC)/Function/PubService/HandlerPubService.o \
#		$(BASEDIR_SRC)/Function/PubService/HttpServerPubService.o \
#		$(BASEDIR_SRC)/Function/PubService/AgentPubService.o

#######################################################################################################
##SmsOverHttp服务器
#CFLAGS += -DUSE_SMSOVERHTTP
#
#OBJS_GENERALAGENT += \
#		$(BASEDIR_SRC)/Function/Stack/SmsStack.o
#
#OBJS_GENERALAGENT += \
#		$(BASEDIR_SRC)/Function/SmsOverHttp/HandlerSmsOverHttp.o \
#		$(BASEDIR_SRC)/Function/SmsOverHttp/HttpServerSmsOverHttp.o \
#		$(BASEDIR_SRC)/Function/SmsOverHttp/AgentSmsOverHttp.o

#######################################################################################################
###Ass服务器
#CFLAGS += -DUSE_ASSOVERHTTP
#
##OBJS_GENERALAGENT += \
##		$(BASEDIR_SRC)/Function/Stack/SmsStack.o
#
#OBJS_GENERALAGENT += \
#		$(BASEDIR_SRC)/Function/AssOverHttp/HandlerAssOverHttp.o \
#		$(BASEDIR_SRC)/Function/AssOverHttp/HttpServerAssOverHttp.o \
#		$(BASEDIR_SRC)/Function/AssOverHttp/AgentAssOverHttp.o

######################################################################################################
##使用数据库
CFLAGS += -D_USE_DBAGENT_OCCI

ifeq ($(PLATFORM),linux-x86-32)
	CFLAGS += -I/usr/include/oracle/11.2/client/
	LIBS += -L/usr/lib/oracle/11.2/client/lib/ -locci -lsqlplus
else ifeq ($(PLATFORM),linux-hi3515)
	CFLAGS += -I/usr/include/oracle/11.2/client64/
	LIBS +=	-L/usr/lib/oracle/11.2/client64/lib/ -locci -lsqlplus
else

endif

OBJS_GENERALAGENT += \
		$(BASEDIR_SRC)/DBAgent/ltUtcsDbAgent.o

#######################################################################################################
##怡和科技对接服务
CFLAGS += -DUSE_InterUtcs_YiHeTech

OBJS_GENERALAGENT += \
		$(BASEDIR_SRC)/Function/InterUtcs/Stack/YiHe1Stack.o

OBJS_GENERALAGENT += \
		$(BASEDIR_SRC)/Function/InterUtcs/YiHeTech/HandlerInterUtcs_YiHeTech.o \
		$(BASEDIR_SRC)/Function/InterUtcs/YiHeTech/HttpServerInterUtcs_YiHeTech.o \
		$(BASEDIR_SRC)/Function/InterUtcs/YiHeTech/AgentInterUtcs_YiHeTech.o

## tinyXML
CFLAGS += -I$(EZLIBS_BASEDIR_LIBS)/include/tinyXML
CFLAGS += -DTIXML_USE_STL
LIBS += -L$(EZLIBS_BASEDIR_LIBS)/lib -ltinyXML-$(PLATFORM)

##############################################################################
# use ezutil library for http_parse
CFLAGS += -I$(EZLIBS_BASEDIR_LIBS)/include/ezutil
LIBS +=	-L$(EZLIBS_BASEDIR_LIBS)/lib -lezutil-$(PLATFORM)
# ezUtilCPP
CFLAGS += -I$(EZLIBS_BASEDIR_LIBS)/include/ezUtilCPP/
LIBS +=	-L$(EZLIBS_BASEDIR_LIBS)/lib -lezUtilCPP-$(PLATFORM)

CFLAGS += -I$(EZLIBS_BASEDIR_LIBS)/include/ppSockets
LIBS +=	-L$(EZLIBS_BASEDIR_LIBS)/lib -lppSockets-$(PLATFORM)

## json
CFLAGS += -I$(EZLIBS_BASEDIR_LIBS)/include/json
LIBS += -L$(EZLIBS_BASEDIR_LIBS)/lib -ljson-$(PLATFORM)
#
CFLAGS += -I$(EZLIBS_BASEDIR_LIBS)/include/ezThread
LIBS +=	-L$(EZLIBS_BASEDIR_LIBS)/lib -lezThread-$(PLATFORM)
LIBS +=	-lpthread -ldl
##zlib
CFLAGS += -I$(EZLIBS_BASEDIR_LIBS)/include/zlib
LIBS += -L$(EZLIBS_BASEDIR_LIBS)/lib -lz-$(PLATFORM)

#libsigc, do not use it now, use mysignal instead
#CFLAGS+=-I$(EZLIBS_BASEDIR_LIBS)/libsigc++-$(PLATFORM)/lib/sigc++-2.0/include
#CFLAGS+=-I$(EZLIBS_BASEDIR_LIBS)/libsigc++-$(PLATFORM)/include/sigc++-2.0
#LIBS +=	-L$(EZLIBS_BASEDIR_LIBS)/libsigc++-$(PLATFORM)/lib/ -lsigc-2.0

CFLAGS += -DHAVE_LIBUUID
CFLAGS += -I$(EZLIBS_BASEDIR_LIBS)/include
LIBS += -L$(EZLIBS_BASEDIR_LIBS)/lib -luuid-$(PLATFORM)

#利用main调用，不用ezthread库
OBJS_MAINTHREAD_P = $(BASEDIR_SRC)/main.o
OBJS_MAINTHREAD_P += $(OBJS_GENERALAGENT)
OBJS_MAINTHREAD_P += $(OBJS_CONFIGS)
DIST_MAINTHREAD = $(PROJECT_NAME)MainThread-$(PLATFORM)

#多线程，用ezthread库
OBJS_MULTITHREAD_P = \
		$(BASEDIR_SRC)/Solar.o \
		$(BASEDIR_SRC)/Console/FunConsole.o \
		$(BASEDIR_SRC)/Main.o
OBJS_MULTITHREAD_P += $(OBJS_GENERALAGENT)
OBJS_MULTITHREAD_P += $(OBJS_CONFIGS)
DIST_MULTITHREAD = $(PROJECT_NAME)-$(PLATFORM)

DIST =	$(DIST_MULTITHREAD)
#服务器不要使用这种方式
#DIST +=	$(DIST_MAINTHREAD)

all: $(DIST)
	@mkdir -p ../bin
	@mv $(DIST) ../bin
	@echo "Done, to ../bin for the object."

$(DIST_MAINTHREAD):$(OBJS_MAINTHREAD_P)
		$(CPP) -o $@ $^ $(LIBS)

$(DIST_MULTITHREAD):$(OBJS_MULTITHREAD_P)
		$(CPP) -o $@ $^ $(LIBS)

tar:	clean
		tar -czf $(PROJECT_NAME).tgz *.h *.cpp Makefile*

-include *.d

.c.o:
	$(CC) -c $(CFLAGS) $< -o $@

.cpp.o:
	$(CPP) -c $(CFLAGS) $< -o $@

clean:
	find $(BASEDIR_SRC) -name "*.o" |xargs rm -f
	find $(BASEDIR_SRC) -name "*.d" |xargs rm -f
	find $(BASEDIR_SRC) -name "*.cfbk" |xargs rm -f
	rm -rf ../bin/*

dirclean:clean
	rm -f cfg-*.cfg*
	rm -rf logs/

dbg:all
	../bin/$(DIST)
