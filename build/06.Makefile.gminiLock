##############################################################################
# 网络串口
CFLAGS += -D_DEV_NetSerialTCPSOCKETCONNECTOR
NetSerial_BASEDIR_SRC=$(BASEDIR_SRC)/Device/NetSerial/src/
OBJS_NetSerial = \
		$(NetSerial_BASEDIR_SRC)/NetSerialLog.o \
		$(NetSerial_BASEDIR_SRC)/NetSerialHandler.o\
		$(NetSerial_BASEDIR_SRC)/NetSerialTcpSocket.o \
		$(NetSerial_BASEDIR_SRC)/NetSerial.o
OBJS_CONFIGS += $(BASEDIR_SRC)/Configs/ConfigNetSerialTcpCli.o

# -cli
OBJS_NetSerial += \
		$(NetSerial_BASEDIR_SRC)/NetSerialTcpSocketConnector.o

CFLAGS += -DEXAMPLE_SIGNAL_ONDATA #使用数据回调机制

##############################################################################
# 串口设备
CFLAGS += -D_DEV_SERIAL
CFLAGS += -I${EZLIBS_BASEDIR_LIBS}/include/ezserial
LIBS += -L${EZLIBS_BASEDIR_LIBS}/lib -lezserial-$(PLATFORM)
OBJS_GENERALAGENT += \
		$(BASEDIR_SRC)/Device/DevSerial.o    \
		$(BASEDIR_SRC)/Device/carry_io_board.o

