#######################################################################################################
##web管理功能 —— 浏览器管理
CFLAGS += -DXP_FaceWebs

#CFLAGS  += -DUSER_MANAGEMENT_SUPPORT
# Digest Access switch
#CFLAGS  += -DDIGEST_ACCESS_SUPPORT
#   CFLAGS  += -DUSE_USB_INTERFACE -D__UNIT_TEST -DDEV_ENOCEAN_SUPPORT
#CFLAGS  += -DUSE_PROCESS_THREAD
CFLAGS  += -DCHECK_STATUS_THREAD
CFLAGS += -I${EZLIBS_BASEDIR_LIBS}/include/ezutil
LIBS += -L${EZLIBS_BASEDIR_LIBS}/lib -lezutil-$(PLATFORM)
CFLAGS += -I$(HOME)/libs/include/ezsocket
LIBS += -L$(HOME)/libs/lib -lezsocket-$(PLATFORM)

CFLAGS  += -DWEBS -DOS="LINUX" -DLINUX
CFLAGS += -I${EZLIBS_BASEDIR_LIBS}/include/aspwebs
LIBS += -L${EZLIBS_BASEDIR_LIBS}/lib -laspwebs-$(PLATFORM) -lpthread
CFLAGS += -I${EZLIBS_BASEDIR_LIBS}/include/ezplatform
LIBS += -L${EZLIBS_BASEDIR_LIBS}/lib -lezplatform-$(PLATFORM)
CFLAGS += -I${EZLIBS_BASEDIR_LIBS}/include/ezutil_platform
LIBS += -L${EZLIBS_BASEDIR_LIBS}/lib -lezutil_platform-$(PLATFORM) -lrt

OBJS_CONFIGS+=$(BASEDIR_SRC)/Configs/ConfigFaceWebs.o

OBJS_GENERALAGENT += \
		$(BASEDIR_SRC)/FaceWebs/FaceWebs.o      \
		$(BASEDIR_SRC)/FaceWebs/ez_asp_webs.o      \
		$(BASEDIR_SRC)/FaceWebs/websFunction.o

#######################################################################################################
##GeminiLock, 需要用到devserial 或者netserial 或者二者均使用
CFLAGS += -DFUNC_GEMINILOCK

OBJS_CONFIGS+=$(BASEDIR_SRC)/Configs/ConfigGeminiLock.o

CFLAGS+=-I$(EZLIBS_BASEDIR_LIBS)/openssl-$(PLATFORM)/include
LIBS +=	-L$(EZLIBS_BASEDIR_LIBS)/openssl-$(PLATFORM)/lib -lcrypto

OBJS_GENERALAGENT += \
		$(BASEDIR_SRC)/Function/GeminiKey/GeminiKey.o      \
		$(BASEDIR_SRC)/Function/GeminiKey/GeminiKeyStack.o	\
		$(BASEDIR_SRC)/Function/GeminiLock/FunGeminiLock.o				\
		$(BASEDIR_SRC)/Device/DevLock_D1.o

#CFLAGS += -DFUNC_UsbStorageKey
OBJS_GENERALAGENT+=$(BASEDIR_SRC)/Device/DevHotPlug.o
OBJS_GENERALAGENT+=$(BASEDIR_SRC)/Device/DevUsbStorageKey.o
#OBJS_GENERALAGENT+=$(BASEDIR_SRC)/Function/GeminiLock/FunUsbStorageKey.o

#######################################################################################################
#InterThings_gLock服务器，for GeminiLock
CFLAGS += -D_USE_InterThings_gLock

OBJS_GENERALAGENT += \
		$(BASEDIR_SRC)/Function/Stack/gLock/InterThings_gLockStack.o

OBJS_GENERALAGENT += \
		$(BASEDIR_SRC)/Function/InterThings/gLock/HandlerInterThings_gLock.o \
		$(BASEDIR_SRC)/Function/InterThings/gLock/HttpServerInterThings_gLock.o \
		$(BASEDIR_SRC)/Function/InterThings/gLock/AgentInterThings_gLock.o
OBJS_CONFIGS += $(BASEDIR_SRC)/Configs/ConfigInterThings_gLock.o 

##############################################################################
#CFLAGS += -DFUNC_KnxIpCu
#OBJS_CONFIGS+=$(BASEDIR_SRC)/Configs/ConfigKnxIpCu.o

##############################################################################
#CFLAGS += -DFUNC_KnxIpGw
#OBJS_CONFIGS+=$(BASEDIR_SRC)/Configs/ConfigKnxIpGw.o



##############################################################################
# use ezutil library for http_parse
CFLAGS += -I$(EZLIBS_BASEDIR_LIBS)/include/ezutil
LIBS +=	-L$(EZLIBS_BASEDIR_LIBS)/lib -lezutil-$(PLATFORM)
# ezUtilCPP
CFLAGS += -I$(EZLIBS_BASEDIR_LIBS)/include/ezUtilCPP/
LIBS +=	-L$(EZLIBS_BASEDIR_LIBS)/lib -lezUtilCPP-$(PLATFORM)

CFLAGS += -I$(EZLIBS_BASEDIR_LIBS)/include/ppSockets
LIBS +=	-L$(EZLIBS_BASEDIR_LIBS)/lib -lppSockets-$(PLATFORM)

## json
CFLAGS += -I$(EZLIBS_BASEDIR_LIBS)/include/json
LIBS += -L$(EZLIBS_BASEDIR_LIBS)/lib -ljson-$(PLATFORM)
#
CFLAGS += -I$(EZLIBS_BASEDIR_LIBS)/include/ezThread
LIBS +=	-L$(EZLIBS_BASEDIR_LIBS)/lib -lezThread-$(PLATFORM)
LIBS +=	-lpthread -ldl
##zlib
CFLAGS += -I$(EZLIBS_BASEDIR_LIBS)/include/zlib
LIBS += -L$(EZLIBS_BASEDIR_LIBS)/lib -lz-$(PLATFORM)

#libsigc, do not use it now, use mysignal instead
#CFLAGS+=-I$(EZLIBS_BASEDIR_LIBS)/libsigc++-$(PLATFORM)/lib/sigc++-2.0/include
#CFLAGS+=-I$(EZLIBS_BASEDIR_LIBS)/libsigc++-$(PLATFORM)/include/sigc++-2.0
#LIBS +=	-L$(EZLIBS_BASEDIR_LIBS)/libsigc++-$(PLATFORM)/lib/ -lsigc-2.0

CFLAGS += -DHAVE_LIBUUID
CFLAGS += -I$(EZLIBS_BASEDIR_LIBS)/include
LIBS += -L$(EZLIBS_BASEDIR_LIBS)/lib -luuid-$(PLATFORM)

#利用main调用，不用ezthread库
OBJS_MAINTHREAD_P = $(BASEDIR_SRC)/main.o
OBJS_MAINTHREAD_P += $(OBJS_GENERALAGENT)
OBJS_MAINTHREAD_P += $(OBJS_CONFIGS)
OBJS_MAINTHREAD_P += $(OBJS_NetSerial)
DIST_MAINTHREAD = $(PROJECT_NAME)MainThread-$(PLATFORM)

#多线程，用ezthread库
OBJS_MULTITHREAD_P = \
		$(BASEDIR_SRC)/Solar.o \
		$(BASEDIR_SRC)/Console/LocalConsole.o \
		$(BASEDIR_SRC)/Console/FunConsole.o \
		$(BASEDIR_SRC)/Main.o
OBJS_MULTITHREAD_P += $(OBJS_GENERALAGENT)
OBJS_MULTITHREAD_P += $(OBJS_CONFIGS)
OBJS_MULTITHREAD_P += $(OBJS_NetSerial)
DIST_MULTITHREAD = $(PROJECT_NAME)-$(PLATFORM)
#DIST_MULTITHREAD = ../bin/$(PROJECT_NAME)-$(PLATFORM)

#动态库方式，供c等调用
OBJS_DYN_LIBS = \
		$(BASEDIR_SRC)/Solar.o \
		$(BASEDIR_SRC)/LocalConsole.o \
		$(BASEDIR_SRC)/UniTrans.o
OBJS_DYN_LIBS += $(OBJS_GENERALAGENT)
OBJS_DYN_LIBS += $(OBJS_CONFIGS)
OBJS_DYN_LIBS += $(OBJS_NetSerial)
DYN_LIBS = lib$(PROJECT_NAME)-$(PLATFORM).so
PATH_DYN_LIBS = ../outlib

DIST =	$(DIST_MULTITHREAD)
#服务器不要使用这种方式
#DIST +=	$(DIST_MAINTHREAD)

all: $(DIST)
	@mkdir -p ../bin
	#@mv $(DIST) ../bin
	#@echo "Done, to ../bin for the object."

dbg: $(DIST)
	@mv $(DIST) /home/share/glock

$(DIST_MAINTHREAD):$(OBJS_MAINTHREAD_P)
		$(CPP) -o $@ $^ $(LIBS)

$(DIST_MULTITHREAD):$(OBJS_MULTITHREAD_P)
		$(CPP) -o $@ $^ $(LIBS)

dyn:$(DYN_LIBS)
	@mkdir -p $(PATH_DYN_LIBS)
	@mv $(DYN_LIBS) $(PATH_DYN_LIBS)
	@echo "Done, to $(PATH_DYN_LIBS) for the object."

dyndbg:all
	gcc -c ../src/main.c -I../src -std=gnu99  
	gcc -o uni main.o -L../outlib/ -luniTrans-linux-x86-32
	#export LD_LIBRARY_PATH=$LD_LIBRARY_PATH:../outlib/
	#./uni

$(DYN_LIBS):$(OBJS_DYN_LIBS)
		$(CPP) -shared -o $@ $^ $(LIBS)

#tar:	clean
#		tar -czf $(PROJECT_NAME).tgz *.h *.cpp Makefile*

-include *.d

.c.o:
	$(CC) -c $(CFLAGS) $< -o $@

.cpp.o:
	$(CPP) -c $(CFLAGS) $< -o $@

clean:
	find $(BASEDIR_SRC) -name "*.o" |xargs rm -f
	find $(BASEDIR_SRC) -name "*.d" |xargs rm -f
	find $(BASEDIR_SRC) -name "*.cfbk" |xargs rm -f

dirclean:clean
	sudo rm -f cfg-*.cfg*
	sudo rm -rf logs/
	rm -rf ../bin/*
	rm -rf ./spages umconfig.txt
	rm -rf $(PATH_DYN_LIBS)

prepare:all
	rm -rf ./spages
	cp -rf ../scripts/spages/geminilock .; mv geminilock spages
	cp -f ../scripts/spages/umconfig.txt .
	#cp $(DIST) .

sim:prepare
	sudo ./$(DIST)

#release all
rel:prepare
	rm -f gll.tgz
	find ./spages/ -name ".svn" | xargs rm -rf
	tar -czvf gll.tgz $(DIST) umconfig.txt spages 
