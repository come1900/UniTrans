#利用main调用，不用ezthread库
OBJS_MAINTHREAD_P = $(BASEDIR_SRC)/main.o
OBJS_MAINTHREAD_P += $(OBJS_GENERALAGENT)
OBJS_MAINTHREAD_P += $(OBJS_CONFIGS)
DIST_MAINTHREAD = generalAgentMain-HttpConn-$(PLATFORM)

#多线程，用ezthread库
OBJS_MULTITHREAD_P = \
		$(BASEDIR_SRC)/Solar.o \
		$(BASEDIR_SRC)/Console/LocalConsole.o \
		$(BASEDIR_SRC)/Console/FunConsole.o \
		$(BASEDIR_SRC)/Main.o
OBJS_MULTITHREAD_P += $(OBJS_GENERALAGENT)
OBJS_MULTITHREAD_P += $(OBJS_CONFIGS)
DIST_MULTITHREAD = $(PROJECT_NAME)-$(PLATFORM)

DIST =	$(DIST_MULTITHREAD)
#DIST +=	$(DIST_MAINTHREAD)

all: $(DIST)
	@mkdir -p ../bin
	#@mv $(DIST) ../bin
	#@echo "Done, to ../bin for the object."

$(DIST_MAINTHREAD):$(OBJS_MAINTHREAD_P)
		$(CPP) -o $@ $^ $(LIBS)

$(DIST_MULTITHREAD):$(OBJS_MULTITHREAD_P)
		$(CPP) -o $@ $^ $(LIBS)

#tar:	clean
#		tar -czf $(PROJECT_NAME).tgz *.h *.cpp Makefile*

-include *.d

.c.o:
	$(CC) -c $(CFLAGS) $< -o $@

.cpp.o:
	$(CPP) -c $(CFLAGS) $< -o $@

clean:
	rm -f $(DIST)
	#find $(BASEDIR_SRC) -name "*.o" |xargs rm -f
	#find $(BASEDIR_SRC) -name "*.d" |xargs rm -f
	#find $(BASEDIR_SRC) -name "*.cfbk" |xargs rm -f
	rm -f $(OBJS_MAINTHREAD_P) $(OBJS_MULTITHREAD_P) $(DIST)

dirclean:clean
	rm -f *.cfg*
	rm -rf logs/

prepare:all
	#rm -rf ./spages
	#cp -rf ../scripts/spages/geminilock .; mv geminilock spages
	#cp -f ../scripts/spages/umconfig.txt .
	#cp $(DIST) .

dbg:prepare
	#scp -P50047 pandoraNode-uniTrans-linux-mips-mipsl-openwrt root@9e05c825f2e.ezlibs.com:/tmp/
	scp $(DIST) root@192.168.9.1:/tmp/

sim:prepare
	./$(DIST)

#release all
rel:prepare
	rm -f $(DIST).tgz
	#find ./spages/ -name ".svn" | xargs rm -rf
	tar -czvf $(DIST).tgz $(DIST) #umconfig.txt #spages
